{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "paths": {
      "@org/page-react-news-app": ["./libs/pages/react-news-app/src/index.ts"],
      "@org/api": ["./libs/api/src/index.ts"],
      "@org/utils": ["./libs/utils/src/index.ts"],
      "@org/types": ["./libs/types/src/index.ts"],
      "@org/ui": ["./libs/ui/src/index.ts"],
      "@org/layouts": ["./libs/layouts/src/index.ts"],
      "@org/auth": ["./libs/auth/src/index.ts"],
      "@org/comments": ["./libs/comments/src/index.ts"],
      "@org/news": ["./libs/news/src/index.ts"]
    }
  }
}
